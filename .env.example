PORT=4000
NODE_ENV=development

# Local Postgres only (not Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pra_connector_db?schema=public"

JWT_SECRET="replace-with-a-secure-random-secret"
JWT_EXPIRES_IN="7d"

SUPER_ADMIN_EMAIL="admin@praconnector.com"
SUPER_ADMIN_PASSWORD="replace-admin-password"
DEMO_CUSTOMER_EMAIL="demo@fenzi.com"
DEMO_CUSTOMER_PASSWORD="replace-demo-password"

# Local frontend only — never Vercel
FRONTEND_URL="http://localhost:5173"

# Production QBO; Render = OAuth callback only → handoff to local DB
# Intuit Production Redirect URI (once):
#   https://pra-connector-backend.onrender.com/api/qbo/callback
QBO_CLIENT_ID="replace-with-intuit-production-client-id"
QBO_CLIENT_SECRET="replace-with-intuit-production-client-secret"
QBO_REDIRECT_URI="https://pra-connector-backend.onrender.com/api/qbo/callback"
QBO_ENVIRONMENT="production"
QBO_LOCAL_HANDOFF_ORIGIN="http://localhost:4000"
QBO_HANDOFF_SECRET="replace-with-shared-handoff-secret"
QBO_STATE_SECRET="replace-with-shared-handoff-secret"

PRA_SANDBOX_URL="https://ims.pral.com.pk/ims/sandbox/api/Live/PostData"
PRA_SANDBOX_TOKEN="replace-with-pra-sandbox-token"
